    "download_start_timeout": 90
  },
  "booth": {
    "enabled": true,
    "include_gifts": true,
    "save_thumbnails": true
  },
  "payhip": {
    "enabled": true,
    "library_url": "",
    "headed": true,
    "bot_check_wait": 180,
    "download_start_timeout": 90,
    "save_thumbnails": true
  },
  "tags": {
    "min_count": 3,
    "max_share": 0.4,
    "min_length": 2,
    "extra_stopwords": [],
    "blocklist": []
  }
}
