{
  "root": "downloads",
  "request_delay": 1.0,
  "browser_channel": "",
  "profile_dir": "",
  "gumroad": {
    "enabled": true,
    "include_archived": true,
    "save_thumbnails": true
  },
  "jinxxy": {
