{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hoard",
  "mainBinaryName": "Hoard",
  "version": "0.0.0",
  "identifier": "io.github.soloflighter1010.Hoard.tauri",
  "build": {
    "frontendDist": "page"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "publisher": "SoloFlighter",
    "copyright": "MIT licensed. Not affiliated with VRChat or any store.",
    "category": "Utility",
    "shortDescription": "Your VRChat assets and Unity projects, in one place",
    "longDescription": "Hoard lists everything you've bought for VRChat on Booth, Gumroad, Jinxxy, Payhip and itch.io, downloads it and keeps it up to date, and manages the Unity projects you make with it. This is the experimental build with a Tauri window and a Nuitka-compiled server.",
    "homepage": "https://hoard.furryup.link",
    "license": "MIT",
    "icon": [
      "../packaging/icons/hoard-128.png",
      "../packaging/icons/hoard-256.png",
      "../packaging/icons/hoard-512.png",
      "../packaging/hoard.icns",
      "../packaging/hoard.ico"
    ],
    "resources": {
      "../build/nuitka/server/": "server/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../packaging/hoard.ico",
        "uninstallerIcon": "../packaging/hoard.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": ["English", "Japanese", "Korean"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
