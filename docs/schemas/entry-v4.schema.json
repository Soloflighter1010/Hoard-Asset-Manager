{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoard.furryup.link/schemas/entry-v4.schema.json",
  "type": "object",
  "properties": {
    "store": {
      "enum": [
        "Booth",
        "Gumroad",
        "Jinxxy",
        "Payhip",
        "Itch",
        "Local"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "creator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "folder": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "variants": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "added": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "suggested_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "page": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "library": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "note": {
      "type": "string",
      "minLength": 0,
      "maxLength": 300
    },
    "your_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "needs": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "tool"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "versions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}$"
                },
                "maxItems": 30
              },
              "guids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "minItems": 1,
                "maxItems": 50
              }
            },
            "required": [
              "kind",
              "name",
              "url",
              "versions",
              "guids"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "product"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "creator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "store": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "folder": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "guids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "minItems": 1,
                "maxItems": 50
              }
            },
            "required": [
              "kind",
              "name",
              "creator",
              "store",
              "folder",
              "guids"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 30
    },
    "code": {
      "type": "object",
      "properties": {
        "scripts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999999
        },
        "plugins": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999999
        },
        "editor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999999
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 20
        },
        "folders": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "maxItems": 8
        }
      },
      "required": [
        "scripts",
        "plugins",
        "editor",
        "tools",
        "folders"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "store",
    "name",
    "creator",
    "folder",
    "files",
    "tags",
    "suggested_tags"
  ],
  "additionalProperties": false
}
