# Keep line endings the same on every machine: every text file is LF, whatever git's settings (so Windows
# checkouts, CI on Windows and the release zips match Linux byte for byte). Only the .bat launchers are CRLF,
# which Windows needs.
* text=auto eol=lf
*.bat  text eol=crlf
*.png  binary
*.ico  binary
*.zip  binary
*.woff2 binary
*.ttf   binary
*.unitypackage binary
